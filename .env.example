# Development values only. Change JWT_SECRET for any real deployment.

# HS256 signing key, at least 32 bytes.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Token lifetime, Go duration format (e.g. 15m, 1h, 24h).
JWT_TTL=1h

# Use mongodb://mongo:27017 when running inside docker compose.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=user_management

HTTP_ADDR=:8080
GRPC_ADDR=:50051
